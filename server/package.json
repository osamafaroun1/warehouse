{
    "name": "warehouse-mgmt-server",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "studio": "drizzle-kit studio",
        "db:push": "drizzle-kit push",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:migrate2": "npx tsx scripts/run-migrate.ts",
        "dev": "tsx watch src/index.ts",
        "build:old": "tsc -p tsconfig.json && node scripts/copy-build-assets.mjs",
        "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.cjs --format=cjs && node scripts/copy-build-assets.mjs",
        "tscheck": "tsc --noEmit",
        "format": "dprint fmt",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "node dist/index.cjs",
        "build:sidecar": "node scripts/build-sidecar.mjs",
        "seed": "tsx scripts/seed.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@hono/node-server": "^2.0.8",
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "drizzle-zod": "^0.8.3",
        "hono": "^4.12.30",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "uuid": "^14.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.1.1",
        "@types/pg": "^8.20.0",
        "@yao-pkg/pkg": "^6.21.0",
        "drizzle-kit": "^0.31.10",
        "esbuild": "^0.28.1",
        "eslint": "^9.39.4",
        "globals": "^17.7.0",
        "postject": "^1.0.0-alpha.6",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
}

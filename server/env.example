# Copy this file to `.env` (same folder) and fill in real values before
# running `npm run build` / `npm run tauri:build`. Nothing in this file is
# read automatically — server/src/config/env.ts reads from `.env`, and the
# build step copies `.env` into `dist/.env` so it ships inside the .exe.

# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warehouse

# Two DIFFERENT random secrets (never reuse one for both — see env.ts).
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Must be exactly 32 bytes, base64-encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Optional ---
PORT=3000
NODE_ENV=production

# Non-owner DB role for runtime queries (RLS-enforced). Leave unset to use
# DATABASE_URL for everything (fine for local dev / a single-tenant desktop
# install), see the comment in env.ts for details.
# APP_DATABASE_URL=
# DB_APP_USER=

# Rate limiting store. Leave unset to fall back to an in-memory counter.
# REDIS_URL=

# Default admin account created on first run if the `users` table is empty.
# SEED_ADMIN_EMAIL=admin@warehouse.local
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=Admin123!

# IMPORTANT for the packaged Tauri app on Windows: the WebView2 origin is
# http://tauri.localhost (plain http, not https, and not the tauri:// scheme
# used on macOS/Linux) — leaving it out here causes a silent "Failed to
# fetch" on login in the built .exe even though `npm run dev` works fine.
CORS_ORIGINS=http://localhost:1420,http://localhost:3000,http://tauri.localhost
